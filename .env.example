# Public DNS name pointed at this host. Caddy obtains and renews HTTPS certificates.
DOMAIN=hub.example.com

# Optional narrow CIDRs for health checks of private services. Leave empty by default.
PROBE_ALLOW_CIDRS=

# For compose.agent.yaml only. Must be an absolute host path to the restricted Agent UDS.
AGENT_SOCKET_HOST=/run/projecthub-agent/agent.sock
